# Runtime connection through Supabase's transaction-mode pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct/session-mode connection for schema introspection and migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional fallback for existing server-only database configuration.
SUPABASE_DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# Required: download the database CA certificate from Supabase > Database Settings > SSL Configuration.
DATABASE_SSL_CA="/path/to/supabase-root-ca.crt"

CENTRAL_HOST="127.0.0.1"
CENTRAL_PORT="3000"
# Comma-separated additional browser origins; defaults allow local Live Server on port 5505.
CENTRAL_ALLOWED_ORIGINS=""
