# Runtime connection through Supabase's transaction-mode pooler.
DATABASE_URL="postgresql://postgres.jgsrgzrgiznknvtxhats:@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# Direct/session-mode connection for schema introspection and migrations.
DIRECT_URL="postgresql://postgres.jgsrgzrgiznknvtxhats:@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Optional fallback for existing server-only database configuration.
SUPABASE_DATABASE_URL="https://jgsrgzrgiznknvtxhats.supabase.co"

# Required: download the database CA certificate from Supabase > Database Settings > SSL Configuration.
DATABASE_SSL_CA="/workspaces/frontend_DB/crt/prod-ca-2021.crt"

CENTRAL_HOST="127.0.0.1"
CENTRAL_PORT="3000"
CENTRAL_FRONTEND_PORT="5505"
CENTRAL_SERVE_SITE="true"
# Comma-separated exact browser origins if the site is deployed separately.
CENTRAL_ALLOWED_ORIGINS="https://www.pikachubookingsite.com"

# Developer signup uses unique, one-time codes issued with `npm run accounts:invites -- 12`.
# Session lifetime in hours (1-720; defaults to 168).
CENTRAL_SESSION_TTL_HOURS="168"
