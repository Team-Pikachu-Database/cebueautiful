generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sen {
  id           BigInt   @id @default(autoincrement())
  name         String   @default("")
  location     String
  town         String
  description  String
  price        Decimal  @default(0) @db.Decimal
  rating       Decimal? @default(0) @db.Decimal
  review_count Int      @db.SmallInt
  amenities    String   @default("")
  image_folder String
  image_prefix Int      @default(1)
  image_count  Int
  created_at   DateTime @default(now()) @db.Timestamptz(6)
}

model appUser {
  id            String        @id @db.Uuid
  email         String        @unique
  password_hash String
  role          String        @default("standard")
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  sessions      appSession[]
  developerInvites appDeveloperInvite[]

  @@map("app_users")
}

model appSession {
  token_hash String    @id @db.Char(64)
  user_id    String    @db.Uuid
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       appUser   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("app_sessions")
}

model appDeveloperInvite {
  code_hash  String    @id @db.Char(64)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime? @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  used_by    String?   @db.Uuid
  user       appUser?  @relation(fields: [used_by], references: [id], onDelete: SetNull)

  @@index([used_at, expires_at])
  @@map("app_developer_invites")
}
