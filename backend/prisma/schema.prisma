generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model sen {
  id           BigInt   @id @default(autoincrement())
  name         String   @default("")
  location     String
  town         String
  description  String
  price        Decimal  @default(0) @db.Decimal
  rating       Decimal? @default(0) @db.Decimal
  review_count Int      @db.SmallInt
  amenities    String   @default("")
  image_folder String
  image_prefix Int      @default(1)
  image_count  Int
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  roomInventory hotelRoomInventory?
}

model hotelRoomInventory {
  hotel_id    BigInt        @id
  total_rooms Int           @default(5)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  hotel       sen           @relation(fields: [hotel_id], references: [id], onDelete: Cascade)
  bookings    roomBooking[]

  @@map("hotel_room_inventory")
}

model roomBooking {
  id               String             @id @db.Uuid
  user_id          String?            @db.Uuid
  booking_reference String            @unique
  hotel_id         BigInt
  guest_name       String
  guest_email      String
  check_in         DateTime           @db.Date
  check_out        DateTime           @db.Date
  rooms            Int
  total_price      Decimal            @db.Decimal(12, 2)
  payment_status   String             @default("pending")
  paid_at          DateTime?          @db.Timestamptz(6)
  cancelled_at     DateTime?          @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  inventory        hotelRoomInventory @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade)
  user             appUser?           @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([hotel_id, check_in, check_out])
  @@map("room_bookings")
}

model appUser {
  id            String        @id @db.Uuid
  email         String        @unique
  password_hash String
  role          String        @default("standard")
  full_name     String        @default("")
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  sessions      appSession[]
  developerInvites appDeveloperInvite[]
  bookings      roomBooking[]

  @@map("app_users")
}

model appSession {
  token_hash String    @id @db.Char(64)
  user_id    String    @db.Uuid
  expires_at DateTime  @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       appUser   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@map("app_sessions")
}

model appDeveloperInvite {
  code_hash  String    @id @db.Char(64)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  expires_at DateTime? @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  used_by    String?   @db.Uuid
  user       appUser?  @relation(fields: [used_by], references: [id], onDelete: SetNull)

  @@index([used_at, expires_at])
  @@map("app_developer_invites")
}
